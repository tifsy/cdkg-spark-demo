# ---------- Task 1: Media Cloud (optional for the demo) ----------
# Leave empty and use the random generator or your own texts.
# Full article text needs an account with text access; otherwise only titles are used.
MEDIACLOUD_API_KEY=

# ---------- LLM (any OpenAI-compatible API) ----------
# Option A: local model with Ollama (free, nothing leaves the machine)
LLM_PROVIDER=openai          # openai = OpenAI-compatible protocol | mock = heuristics, no LLM
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama           # any value works for Ollama
LLM_MODEL=qwen2.5:14b
# Option B: hosted OpenAI API (uses your OpenAI credits; article text is sent to OpenAI)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-5.4-mini     # any chat model your key can use; the UI lists them if this one is wrong
LLM_TIMEOUT=180
LLM_TEMPERATURE=0            # dropped automatically if the model only allows its default
LLM_FALLBACK=false           # true = use heuristics when the LLM fails (labelled heuristic-fallback)

# ---------- Task 2: collection-review-tool ----------
CRT_MODE=mock                # mock (built-in demo queue) | live
CRT_BASE_URL=http://localhost:5000
INSPECTOR_MODE=fixture       # fixture (offline snapshots) | live (visit real sites)
INSPECTOR_BACKEND=requests   # requests | crawl4ai
REVIEW_MIN_CONFIDENCE=0.70

# ---------- Server ----------
HOST=0.0.0.0
PORT=8080
# Optional extra protection for write actions (sent as X-App-Token)
APP_TOKEN=
HIDE_FULLTEXT=true
DATA_DIR=./data
